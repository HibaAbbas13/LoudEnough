# AssemblyAI — powers the entire voice interaction.
# https://www.assemblyai.com/dashboard/api-keys
# Stays on the server: the browser only ever receives a single-use session token.
ASSEMBLYAI_API_KEY=

# Anthropic — writes the final message from the verified brief.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Which model drafts the message. Defaults to claude-sonnet-5,
# chosen for latency: this runs inside a spoken conversation.
# DRAFT_MODEL=claude-sonnet-5
